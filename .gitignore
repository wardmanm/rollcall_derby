# Yarn 4 — keep shareable config, ignore install state and caches
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
node_modules/

# Server data (SQLite database, uploaded media)
data/

# Build output
dist/

# Playwright output
e2e/test-results/
e2e/playwright-report/

# Editors and OS
.DS_Store

# Storybook and Vitest browser-mode output
storybook-static/
*storybook.log
__screenshots__/

# Personal agent settings (not shared)
CLAUDE.local.md
.claude/settings.local.json
